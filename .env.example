# Environment configuration for the portfolio.
#
# Copy to .env for your own reference, or set these directly in your shell
# and in the deployment provider's environment settings. The application
# reads real environment variables; .env itself is git-ignored and is never
# required for the site to run.
#
# This site has no API keys, no database, and no third-party credentials.
# If that ever changes, the value belongs here as a placeholder only.

# development (default) | production
#   development: /docs, /redoc and /openapi.json are served, no HSTS header.
#   production:  those three are not served, and HSTS is sent. Set this only
#                where the platform terminates HTTPS.
APP_ENV=development
